# Provedor de IA — qualquer API compatível com Chat Completions da OpenAI.
# Gemini:   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  AI_MODEL=gemini-3.5-flash
# OpenAI:   AI_BASE_URL=                                                          AI_MODEL=gpt-...
# Vercel:   AI_BASE_URL=https://ai-gateway.vercel.sh/v1                           AI_MODEL=anthropic/claude-opus-5
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3.5-flash

# Embeddings para RAG — endpoint compatível com OpenAI /v1/embeddings.
# Sem configurar, o RAG fica desativado (o tutor funciona normalmente sem grounding).
EMBEDDINGS_API_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIM=1536

# Memória de longo prazo por aluno (opcional — sem chave, tutor roda sem Mem0)
MEM0_API_KEY=m0-...

# Banco de dados
DATABASE_URL=postgresql+asyncpg://nerv:nerv@localhost:5432/nerv_ai

# Cache
REDIS_URL=redis://localhost:6379/0

# Storage Cloudflare R2 (Fase 2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nerv-ai-uploads
R2_PUBLIC_URL=https://uploads.nerv.ai

# Auth
JWT_SECRET_KEY=troque-por-um-segredo-de-256-bits
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Email via Resend (Fase 2)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@nerv.ai

# App
APP_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
