# Build a partir da RAIZ do repositorio (railway.toml aponta este arquivo em
# infra/, entao o contexto e' a raiz — os COPY precisam do prefixo backend/).
FROM python:3.12-slim

WORKDIR /app

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ .

EXPOSE 8000

# A porta vem do ambiente na hospedagem; 8000 e' o padrao local.
CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000}"]
