# ===================== NERV AI — producao na VPS =====================
# Copie para `.env` NA RAIZ DO REPO DENTRO DA VPS e preencha. O `.env` e'
# gitignorado: segredo nenhum entra no repositorio.
#
# Subir:  cd infra && docker compose --env-file ../.env -f docker-compose.prod.yml up -d --build

# ---------- Exposicao na VPS ----------
# Porta alta publicada SO em 127.0.0.1. A VPS ja roda outros projetos: se esta
# porta estiver ocupada, troque — nao mexa nas portas 80/443 nem nas deles.
NERV_HTTP_PORT=18080

# Onde a porta acima escuta. Padrao 127.0.0.1: so o proxy da VPS alcanca.
# Use 0.0.0.0 apenas para acesso provisorio por IP, sem dominio e sem TLS.
NERV_BIND=127.0.0.1

# URL publica final do NERV. O vhost do proxy que ja existe na VPS aponta para
# 127.0.0.1:NERV_HTTP_PORT e responde neste endereco.
PUBLIC_BASE_URL=https://nerv.seudominio.com.br

# ---------- Postgres (interno; nao publica porta) ----------
POSTGRES_USER=nerv
POSTGRES_PASSWORD=TROQUE-por-um-segredo-forte
POSTGRES_DB=nerv_ai

# DATABASE_URL e REDIS_URL sao montadas pelo docker-compose.prod.yml a partir
# das variaveis acima — nao defina aqui, seria ignorado.

# ---------- App ----------
APP_ENV=production
# Origem unica: front e back respondem no mesmo dominio.
FRONTEND_URL=https://nerv.seudominio.com.br
BACKEND_URL=https://nerv.seudominio.com.br/api

# ---------- Auth ----------
# Gere com:  openssl rand -hex 32
JWT_SECRET_KEY=TROQUE-por-256-bits-aleatorios
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------- Provedor de IA (compativel com Chat Completions da OpenAI) ----------
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3.5-flash

# ---------- Embeddings do RAG (opcional) ----------
# Sem isto o tutor funciona, so perde o grounding no corpus BNCC/ENEM.
EMBEDDINGS_API_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIM=1536

# ---------- Memoria de longo prazo (opcional) ----------
MEM0_API_KEY=

# ---------- Storage ----------
# Na VPS o disco persiste: sem credenciais R2 o upload grava no volume
# nerv-ai-uploads e e' servido em /api/uploads/. R2 vira opcional, nao requisito.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nerv-ai-uploads
R2_PUBLIC_URL=

# ---------- Email (opcional; sem chave as notificacoes so logam) ----------
RESEND_API_KEY=
EMAIL_FROM=noreply@nerv.ai
